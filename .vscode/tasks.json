{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "compile",
      "group": "build",
      "problemMatcher": ["$tsc"]
    },
    {
      "type": "npm",
      "script": "watch",
      "group": { "kind": "build", "isDefault": true },
      "isBackground": true,
      "problemMatcher": ["$tsc-watch"]
    },
    {
      "type": "npm",
      "script": "build:integration",
      "group": "build",
      "problemMatcher": []
    }
  ]
}
